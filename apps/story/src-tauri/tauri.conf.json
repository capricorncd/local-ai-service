{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Story",
  "version": "0.1.0",
  "identifier": "studio.local-ai.story",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI · 剧本与分镜",
        "width": 1500,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#17171c",
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../server/": "server/",
      "../skills/": "skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}