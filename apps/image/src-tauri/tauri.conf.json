{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Image",
  "version": "0.1.0",
  "identifier": "studio.local-ai.image",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI · Image",
        "width": 1380,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 740,
        "backgroundColor": "#f4f6f8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../server/": "server/"
    }
  }
}
